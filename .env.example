# K2 Group API environment template.
# Copy to apps/api/.env and replace every placeholder. Do not commit the copy.
# Production and staging secrets belong in the hosting platform, not in git.

APP_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
SERVICE_NAME=k2-api
SERVICE_VERSION=0.1.0

# Development database k2_dev. Integration tests use TEST_DATABASE_URL (name must end with _test).
DATABASE_URL=postgresql://k2:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/k2_dev
TEST_DATABASE_URL=postgresql://k2:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/k2_test
DATABASE_POOL_MAX=10
# disable | no-verify | verify
# disable is rejected for public hosts in staging and production.
# Railway private hosts (*.railway.internal) may use disable.
DATABASE_SSL=disable

# Comma-separated browser origins. A wildcard is rejected in every environment.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
