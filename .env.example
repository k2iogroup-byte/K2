# K2 Group API environment template.
# Copy to apps/api/.env and replace every placeholder. Do not commit the copy.
# Production and staging secrets belong in the hosting platform, not in git.

APP_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
SERVICE_NAME=k2-api
SERVICE_VERSION=0.1.0

# Development database k2_dev. Integration tests use TEST_DATABASE_URL (name must end with _test).
DATABASE_URL=postgresql://k2:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/k2_dev
TEST_DATABASE_URL=postgresql://k2:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/k2_test
DATABASE_POOL_MAX=10
# disable | no-verify | verify
# disable is rejected for public hosts in staging and production.
# Railway private hosts (*.railway.internal) may use disable.
DATABASE_SSL=disable

# Comma-separated browser origins. A wildcard is rejected in every environment.
# The first origin is the web origin used in email links unless WEB_ORIGIN is set.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# 32-byte key, base64. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# The development fixture is rejected outside development. Do not commit a real key.
MFA_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# capture (development mailbox) | unconfigured | smtp
# capture is rejected outside development. Production must set this explicitly.
EMAIL_DELIVERY=capture
# EMAIL_OUTBOX_PATH=apps/api/.email-outbox
# WEB_ORIGIN=http://127.0.0.1:3000
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_FROM=noreply@example.com
# SMTP_USER=
# SMTP_PASSWORD=

# disconnected | test-fixture
# test-fixture is rejected outside development. It never connects to a market-data vendor.
# No provider API key is configured or accepted.
MARKET_DATA_MODE=disconnected
