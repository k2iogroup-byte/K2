{
  "name": "@k2/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node dist/infrastructure/db/migrate-cli.js up",
    "db:rollback": "node dist/infrastructure/db/migrate-cli.js down",
    "db:status": "node dist/infrastructure/db/migrate-cli.js status",
    "db:migrate:dev": "tsx src/infrastructure/db/migrate-cli.ts up",
    "db:rollback:dev": "tsx src/infrastructure/db/migrate-cli.ts down",
    "db:status:dev": "tsx src/infrastructure/db/migrate-cli.ts status"
  },
  "dependencies": {
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/websocket": "11.3.7",
    "@k2/shared": "0.1.0",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
